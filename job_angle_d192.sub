#!/bin/bash
#SBATCH --job-name=angle_d192
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=runs/slurm-%x-%j.out

cd "$SLURM_SUBMIT_DIR" || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
python -c "import torch; assert torch.cuda.is_available(); print(torch.__version__,torch.cuda.get_device_name(0))" || exit 2
export PYTORCH_ALLOC_CONF=expandable_segments:True
set -o pipefail

CFG=config/base.yaml
C=/aifs/user/data/lishanglin/chenhao/angleTransformer/cache_full10
O=runs/angle_d192
mkdir -p "$O"
echo "ANGLE_JOB_START host=$(hostname) time=$(date '+%F %T')"
python -m unittest discover -s tests -v || exit 4
python -m data.inspect_root --config "$CFG" || exit 5
if [[ ! -f "$C/meta.json" || ! -f "$C/train.npz" || ! -f "$C/val.npz" || ! -f "$C/test.npz" ]]; then
  echo "ANGLE_CACHE_BUILD_START time=$(date '+%F %T')"
  python -m data.preprocess --config "$CFG" --set paths.cache_dir="$C" \
    2>&1 | tee "$O/preprocess.log" || exit 6
  echo "ANGLE_CACHE_BUILD_OK time=$(date '+%F %T')"
fi
if python train.py --config "$CFG" --set paths.cache_dir="$C" paths.out_dir="$O" \
     2>&1 | tee "$O/train.log"; then
  python evaluate.py --config "$CFG" --set paths.cache_dir="$C" paths.out_dir="$O" \
    2>&1 | tee "$O/evaluate.log"
  python probe.py --config "$CFG" --set paths.cache_dir="$C" paths.out_dir="$O" \
    2>&1 | tee "$O/probe.log"
  python export_predictions.py --config "$CFG" --set paths.cache_dir="$C" paths.out_dir="$O" \
    2>&1 | tee "$O/export.log"
  echo "ANGLE_JOB_OK time=$(date '+%F %T')"
else
  echo "ANGLE_JOB_FAILED time=$(date '+%F %T')"
  exit 3
fi
