#!/bin/bash
#SBATCH --job-name=tf_reeval
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=00:30:00
#SBATCH --output=/aifs/user/data/lishanglin/chenhao/transformer/runs/slurm-reeval-%j.out
# Recover the test metrics for the configs whose eval crashed on arch mismatch.
cd /aifs/user/data/lishanglin/chenhao/transformer || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
export PYTORCH_ALLOC_CONF=expandable_segments:True
CFG=config/base.yaml; CACHE=cache_full10
ev() { echo "=== EVAL $1 ($2) ==="; python evaluate.py --config $CFG --set paths.cache_dir=$CACHE paths.out_dir=runs/$1 $2 2>&1 | tail -5; }
ev sw_d128       "model.d_model=128 model.d_free=64"
ev sw_d128_lr1e4 "model.d_model=128 model.d_free=64"
ev sw_d96        "model.d_model=96  model.d_free=48"
echo "REEVAL_DONE"
