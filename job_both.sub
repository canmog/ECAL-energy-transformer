#!/bin/bash
#SBATCH --job-name=tf_both
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=2-00:00:00
#SBATCH --output=runs/slurm-%x-%j.out
# Runs BOTH d256 and d320 sequentially in one job (to fit gpunormal MaxSubmit=4 / 2-GPU).
# Submit from a model folder: sbatch --job-name=<pfx> --export=ALL,PFX=<pfx>[,CACHE=<dir>] job_both.sub
cd "$SLURM_SUBMIT_DIR" || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
export PYTORCH_ALLOC_CONF=expandable_segments:True
set -o pipefail
CFG=config/base.yaml
PFX=${PFX:?need PFX}; EPOCHS=${EPOCHS:-100}; COMP=${COMPILE:-true}
CACHEOPT=""; [ -n "$CACHE" ] && CACHEOPT="paths.cache_dir=$CACHE"
run() {   # name d_model d_free
  mkdir -p runs/$1
  echo "##### [$(date '+%F %T')] TRAIN $1 : d_model=$2 d_free=$3 epochs=$EPOCHS compile=$COMP #####"
  if python train.py --config $CFG --set paths.out_dir=runs/$1 $CACHEOPT model.d_model=$2 model.d_free=$3 model.dropout=0.05 train.epochs=$EPOCHS train.compile=$COMP 2>&1 | tee runs/$1/train.log | tail -6; then
    python evaluate.py --config $CFG --set paths.out_dir=runs/$1 $CACHEOPT model.d_model=$2 model.d_free=$3 2>&1 | tee runs/$1/eval.log | tail -4
    echo "##### DONE $1 #####"
  else
    echo "##### !! $1 TRAIN FAILED #####"
  fi
}
run ${PFX}_d256 256 192
run ${PFX}_d320 320 256
echo "##### BOTH_DONE $PFX $(date '+%F %T') #####"
