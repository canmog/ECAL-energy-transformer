#!/bin/bash
#SBATCH --job-name=tf_ep100_seed
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=runs/slurm-%x-%j.out
# SEED VARIANCE for the 100-epoch champion: same objective/schedule, different seed
# (init + shuffling + augmentation; the cache split itself is fixed by the preprocess
# seed, so the test set is identical). Submit with:  sbatch --export=ALL,SEED=<n> ...
# Gives the error bar that the 1.14% headline number needs.
cd "$SLURM_SUBMIT_DIR" || exit 1
# stagger concurrent starts (two same-second env loads once produced a silent
# conda-activation failure -> ModuleNotFoundError: torch), then VERIFY the env
# loudly instead of trusting the silenced source.
sleep $((SLURM_JOB_ID % 47))
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
if ! python -c "import torch" 2>/dev/null; then
  echo "[warn] env load failed; retrying once"; sleep 60
  source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
  python -c "import torch" || { echo "!! ENV LOAD FAILED TWICE"; exit 9; }
fi
export PYTORCH_ALLOC_CONF=expandable_segments:True
set -o pipefail
SEED=${SEED:?submit with --export=ALL,SEED=<n>}
CFG=config/base.yaml
C=/aifs/user/data/lishanglin/chenhao/transformer/cache_full10
O=runs/v3_ep100_s${SEED}
mkdir -p $O
echo "##### START $(hostname) $(date '+%F %T') seed=${SEED} #####"
if python train.py --config $CFG --set paths.cache_dir=$C paths.out_dir=$O \
     seed=${SEED} train.epochs=100 2>&1 | tee $O/train.log | tail -6; then
  for CK in best best_gauss best_robust best_raw; do
    if [ -f "$O/$CK.pt" ]; then
      python evaluate.py --config $CFG --ckpt $O/$CK.pt --set paths.cache_dir=$C \
        paths.out_dir=$O seed=${SEED} train.amp_dtype=fp32 2>&1 | tee $O/eval_$CK.log | tail -3
      mv -f $O/metrics.json $O/metrics_$CK.json
    fi
  done
  echo "##### SEED${SEED}_DONE $(date '+%F %T') #####"
else
  echo "##### !! SEED${SEED} TRAIN FAILED #####"
fi
