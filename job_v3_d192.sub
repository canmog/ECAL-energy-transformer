#!/bin/bash
#SBATCH --job-name=tf_v3_d192
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=runs/slurm-%x-%j.out
# transformer_v3 d192: champion objective (wdx + fit-quality weighting) with the
# GAUSSIAN-CORE selection metric (core=gauss, bias=gauss). A/B vs v2cham isolates
# the selection estimator (the trained objective is identical). cache_full10, 50 ep.
cd "$SLURM_SUBMIT_DIR" || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
export PYTORCH_ALLOC_CONF=expandable_segments:True
set -o pipefail
CFG=config/base.yaml
C=/aifs/user/data/lishanglin/chenhao/transformer/cache_full10
O=runs/v3_d192
mkdir -p $O
echo "##### START $(hostname) $(date '+%F %T') #####"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
if python train.py --config $CFG --set paths.cache_dir=$C paths.out_dir=$O 2>&1 | tee $O/train.log | tail -8; then
  for CK in best best_gauss best_robust best_raw; do
    if [ -f "$O/$CK.pt" ]; then
      echo "----- evaluate $CK -----"
      python evaluate.py --config $CFG --ckpt $O/$CK.pt --set paths.cache_dir=$C paths.out_dir=$O train.amp_dtype=fp32 2>&1 | tee $O/eval_$CK.log | tail -4
      mv -f $O/metrics.json $O/metrics_$CK.json
    fi
  done
  python probe.py --config $CFG --ckpt $O/best.pt --set paths.cache_dir=$C paths.out_dir=$O 2>&1 | tee $O/probe.log | tail -12
  echo "##### V3_D192_DONE $(date '+%F %T') #####"
else
  echo "##### !! V3_D192 TRAIN FAILED #####"
fi
