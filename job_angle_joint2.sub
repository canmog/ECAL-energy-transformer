#!/bin/bash
# Full-data d192 jobs approved after J1: learned robust layer fit and joint
# angle+energy+reconstruction+concept multi-task training.
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=runs/slurm-%x-%j.out

cd "$SLURM_SUBMIT_DIR" || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1 || exit 2
set -euo pipefail
python -c "import torch; assert torch.cuda.is_available(); print(torch.__version__,torch.cuda.get_device_name(0))"
export PYTORCH_ALLOC_CONF=expandable_segments:True
set -o pipefail

MODE=${1:?missing job mode}
VARIANT=${2:?missing variant name}
shift 2
OVERRIDES=("$@")
CFG=config/base.yaml
C=/aifs/user/data/lishanglin/chenhao/angleTransformer/cache_full10
O="runs/$VARIANT"
mkdir -p "$O"

echo "ANGLE_JOINT2_START mode=$MODE name=$VARIANT host=$(hostname) time=$(date '+%F %T')"
printf 'ANGLE_JOINT2_OVERRIDE %s\n' "${OVERRIDES[@]}"
python -m unittest discover -s tests -v

[[ -s "$C/meta.json" && -s "$C/train.npz" && -s "$C/val.npz" && -s "$C/test.npz" ]] || {
  echo "ANGLE_JOINT2_CACHE_MISSING path=$C"
  exit 6
}

COMMON=("paths.cache_dir=$C" "paths.out_dir=$O"
        "train.num_workers=$SLURM_CPUS_PER_TASK" "${OVERRIDES[@]}")
python train.py --config "$CFG" --set "${COMMON[@]}" 2>&1 | tee "$O/train.log"

if [[ "$MODE" == "joint" ]]; then
  for SELECTION in angle energy; do
    CKPT="$O/best_${SELECTION}.pt"
    E="$O/eval_best_${SELECTION}_t10"
    mkdir -p "$E"
    python evaluate.py --config "$CFG" --ckpt "$CKPT" \
      --set "${COMMON[@]}" "paths.out_dir=$E" \
      data.runtime_threshold_mev=10.0 2>&1 | tee "$E/evaluate.log"
  done
else
  E="$O/eval_t10"
  mkdir -p "$E"
  python evaluate.py --config "$CFG" --ckpt "$O/best.pt" \
    --set "${COMMON[@]}" "paths.out_dir=$E" \
    data.runtime_threshold_mev=10.0 2>&1 | tee "$E/evaluate.log"
fi

# Fixed J1 centroid remains the model-independent comparison. The learned-fit
# checkpoint's own coarse result is stored as centroid_baseline in metrics.json.
E_FIXED="$O/eval_fixed_centroid_t10"
mkdir -p "$E_FIXED"
python evaluate_centroid.py --config "$CFG" --split test --device cuda \
  --weight-power 1.5 --component-views 1,0 \
  --set "${COMMON[@]}" data.runtime_threshold_mev=10.0 \
  2>&1 | tee "$E_FIXED/centroid.log"

echo "ANGLE_JOINT2_OK mode=$MODE name=$VARIANT time=$(date '+%F %T')"
