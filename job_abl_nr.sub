#!/bin/bash
#SBATCH --job-name=tf_abl_nr
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=runs/slurm-%x-%j.out
# Ablation 2: same as abl (plain head, bypass on, NormalizedWeighter, 7-concept trim) but
# with the 2 TeV energy ROLLOFF OFF -> isolates the rolloff (the leading suspect) from the
# +1.66% cost of the new training/data stack. Same data (cache_full10), d192, 50 ep, eager.
cd "$SLURM_SUBMIT_DIR" || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
export PYTORCH_ALLOC_CONF=expandable_segments:True
set -o pipefail
CFG=config/base.yaml
C=/aifs/user/data/lishanglin/chenhao/transformer/cache_full10
O=runs/abl_nr
OV="model.dual_energy_head=false model.bottleneck_residual=true loss.energy_rolloff.enabled=false"
mkdir -p $O
echo "##### START $(hostname) $(date '+%F %T') #####"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
if python train.py --config $CFG --set paths.cache_dir=$C paths.out_dir=$O $OV train.epochs=50 train.compile=false 2>&1 | tee $O/train.log | tail -8; then
  python evaluate.py --config $CFG --set paths.cache_dir=$C paths.out_dir=$O $OV 2>&1 | tee $O/eval.log | tail -6
  python probe.py    --config $CFG --set paths.cache_dir=$C paths.out_dir=$O $OV 2>&1 | tee $O/probe.log | tail -10
  echo "##### ABL_NR_DONE $(date '+%F %T') #####"
else
  echo "##### !! ABL_NR TRAIN FAILED #####"
fi
