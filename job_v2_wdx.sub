#!/bin/bash
#SBATCH --job-name=tf_v2_wdx
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=runs/slurm-%x-%j.out
# Step-1 A/B vs the v2 baseline: SAME config, only train.wd_exclude_1d false -> true.
# Standard transformer recipe: exclude 1-D params (LayerNorm/bias/AttnPool-query) from
# weight decay. Single-factor change so the delta is attributable. Else == job_v2.sub.
cd "$SLURM_SUBMIT_DIR" || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
export PYTORCH_ALLOC_CONF=expandable_segments:True
set -o pipefail
CFG=config/base.yaml
C=/aifs/user/data/lishanglin/chenhao/transformer/cache_full10   # shared strict cache
O=runs/v2_d192_wdx
mkdir -p $O
echo "##### START $(hostname) $(date '+%F %T') #####"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
if python train.py --config $CFG --set paths.cache_dir=$C paths.out_dir=$O train.wd_exclude_1d=true 2>&1 | tee $O/train.log | tail -8; then
  python evaluate.py --config $CFG --set paths.cache_dir=$C paths.out_dir=$O 2>&1 | tee $O/eval.log | tail -6
  python probe.py    --config $CFG --set paths.cache_dir=$C paths.out_dir=$O 2>&1 | tee $O/probe.log | tail -12
  echo "##### V2_WDX_DONE $(date '+%F %T') #####"
else
  echo "##### !! V2_WDX TRAIN FAILED #####"
fi
