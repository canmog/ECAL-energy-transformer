#!/bin/bash
#SBATCH --job-name=tf_chamx03
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=runs/slurm-%x-%j.out
# v2cham + TAIL-AWARE composite selection: select_metric.tail_term=excess, tail_weight=0.3.
# (excess = raw_std - robust). best.pt/early-stop now balance core + tail; best_robust.pt /
# best_raw.pt still saved. Same model as v2cham (wdx + v2m1). cache_full10, d192, 50 ep.
cd "$SLURM_SUBMIT_DIR" || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
export PYTORCH_ALLOC_CONF=expandable_segments:True
set -o pipefail
CFG=config/base.yaml
C=/aifs/user/data/lishanglin/chenhao/transformer/cache_full10
O=runs/v2cham_ex03_d192
mkdir -p $O
echo "##### START $(hostname) $(date '+%F %T') #####"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
if python train.py --config $CFG --set paths.cache_dir=$C paths.out_dir=$O \
     train.select_metric.tail_term=excess train.select_metric.tail_weight=0.3 2>&1 | tee $O/train.log | tail -8; then
  for CK in best best_robust best_raw; do
    if [ -f "$O/$CK.pt" ]; then
      python evaluate.py --config $CFG --ckpt $O/$CK.pt --set paths.cache_dir=$C paths.out_dir=$O 2>&1 | tee $O/eval_$CK.log | tail -4
      mv -f $O/metrics.json $O/metrics_$CK.json
    fi
  done
  python probe.py --config $CFG --ckpt $O/best.pt --set paths.cache_dir=$C paths.out_dir=$O 2>&1 | tee $O/probe.log | tail -12
  echo "##### V2CHAM_EX03_DONE $(date '+%F %T') #####"
else
  echo "##### !! V2CHAM_EX03 TRAIN FAILED #####"
fi
