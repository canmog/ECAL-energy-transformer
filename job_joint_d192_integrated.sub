#!/bin/bash
#SBATCH --job-name=ecal_joint
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=runs/slurm-%x-%j.out

cd "$SLURM_SUBMIT_DIR"
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1 || exit 2
set -euo pipefail
export PYTORCH_ALLOC_CONF=expandable_segments:True

CFG=config/joint.yaml
OUTPUT=runs/joint_d192_seed73111
mkdir -p "$OUTPUT"
python -c "import torch; assert torch.cuda.is_available(); print(torch.__version__, torch.cuda.get_device_name(0))"
python -m unittest discover -s tests -v
python train.py --config "$CFG" --set "paths.out_dir=$OUTPUT" \
  "train.num_workers=$SLURM_CPUS_PER_TASK" 2>&1 | tee "$OUTPUT/train.log"

for selection in angle energy; do
  EVAL_DIR="$OUTPUT/eval_best_$selection"
  mkdir -p "$EVAL_DIR"
  python evaluate_angle.py --config "$CFG" --ckpt "$OUTPUT/best_$selection.pt" \
    --set "paths.out_dir=$EVAL_DIR" "train.num_workers=$SLURM_CPUS_PER_TASK" \
    2>&1 | tee "$EVAL_DIR/evaluate.log"
done
python export_predictions.py --config "$CFG" --ckpt "$OUTPUT/best_angle.pt" \
  --set "paths.out_dir=$OUTPUT" "train.num_workers=$SLURM_CPUS_PER_TASK" \
  2>&1 | tee "$OUTPUT/export.log"
echo "ECAL_JOINT_OK output=$OUTPUT"
