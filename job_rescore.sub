#!/bin/bash
#SBATCH --job-name=tf_v3_rescore
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=runs/slurm-%x-%j.out
# (1) Re-score every saved v2-lineage checkpoint + the 3D-fit anchor with the
#     GAUSSIAN CORE estimator (iterative +/-2 sigma fit) -> runs/rescore/.
# (2) Profile the catastrophic events of the champion (v2cham best.pt) -> runs/outliers/.
# No training; ~20 model evals on the shared cache_full10 test split.
cd "$SLURM_SUBMIT_DIR" || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
export PYTORCH_ALLOC_CONF=expandable_segments:True
set -o pipefail
echo "##### START $(hostname) $(date '+%F %T') #####"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

echo "----- rescore_gauss -----"
python rescore_gauss.py --out runs/rescore 2>&1 | tee runs/rescore_gauss.log

echo "----- outlier_study (champion best.pt) -----"
python outlier_study.py \
  --run /aifs/user/data/lishanglin/chenhao/transformer_v2cham/runs/v2cham_d192 \
  --ckpt best.pt --out runs/outliers 2>&1 | tee runs/outlier_study.log

echo "##### V3_RESCORE_DONE $(date '+%F %T') #####"
