#!/bin/bash
#SBATCH --job-name=tf_holdout2tev
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=runs/slurm-%x-%j.out
# HELD-OUT-TeV EXTRAPOLATION TEST: train the champion configuration with the TRAIN
# split restricted to E <= 2 TeV (data.train_e_max; validation/selection unchanged --
# the metric is already E<=2 TeV), then evaluate the FULL range in fp32. The 2-4 TeV
# test bins measure how much of the TeV performance is genuine profile physics vs the
# training-spectrum prior (bounded support). Compare vs v3_d192_ep100.
cd "$SLURM_SUBMIT_DIR" || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
export PYTORCH_ALLOC_CONF=expandable_segments:True
set -o pipefail
CFG=config/base.yaml
C=/aifs/user/data/lishanglin/chenhao/transformer/cache_full10
O=runs/v3_ep100_lt2tev
mkdir -p $O
echo "##### START $(hostname) $(date '+%F %T') #####"
if python train.py --config $CFG --set paths.cache_dir=$C paths.out_dir=$O \
     data.train_e_max=2000 train.epochs=100 2>&1 | tee $O/train.log | tail -6; then
  for CK in best best_gauss best_robust best_raw; do
    if [ -f "$O/$CK.pt" ]; then
      python evaluate.py --config $CFG --ckpt $O/$CK.pt --set paths.cache_dir=$C \
        paths.out_dir=$O train.amp_dtype=fp32 2>&1 | tee $O/eval_$CK.log | tail -3
      mv -f $O/metrics.json $O/metrics_$CK.json
    fi
  done
  echo "##### HOLDOUT2TEV_DONE $(date '+%F %T') #####"
else
  echo "##### !! HOLDOUT2TEV TRAIN FAILED #####"
fi
