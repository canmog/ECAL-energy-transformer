#!/bin/bash
#SBATCH --job-name=tf_test
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=00:25:00
#SBATCH --output=/aifs/user/data/lishanglin/chenhao/transformer/runs/slurm-test-%j.out
# SLURM submission smoke test: verify sbatch->GPU->env->code->compile all work in
# batch context (hep_sub is not available on this AI platform; this cluster is SLURM).
cd /aifs/user/data/lishanglin/chenhao/transformer || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
export PYTORCH_ALLOC_CONF=expandable_segments:True
echo "=== node $(hostname)  $(date) ==="
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
python -c "import torch;print('torch',torch.__version__,'cuda_ok',torch.cuda.is_available(),torch.cuda.get_device_name(0))"
echo "=== tiny preprocess (20k events, 10 MeV cut) ==="
python -m data.preprocess --config config/base.yaml --set paths.cache_dir=cache_jt data.max_events=20000 2>&1 | tail -3
echo "=== 2-epoch train with compile=true (no workarounds: does inductor crash?) ==="
python train.py --config config/base.yaml --set paths.cache_dir=cache_jt paths.out_dir=runs/_jt \
    train.epochs=2 train.warmup_epochs=1 train.num_workers=4 2>&1 | tail -8
echo "=== JOB_TEST_DONE $(date) ==="
