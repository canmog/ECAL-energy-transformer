#!/bin/bash
#SBATCH --job-name=tf_abl
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=runs/slurm-%x-%j.out
# Ablation of the dual_v1 regression: revert the energy mechanism to the PLAIN pooled
# head (model.dual_energy_head=false, model.bottleneck_residual=true, i.e. the sw_d192
# mechanism) while KEEPING the new training/data stack (NormalizedWeighter + 2 TeV
# rolloff + 7-concept trim). Isolates {dual-head + bypass-off} vs {weighter+rolloff+trim}.
# Same data (cache_full10), d192, 50 ep. compile=false (the inductor bug hit m4 & m2).
cd "$SLURM_SUBMIT_DIR" || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
export PYTORCH_ALLOC_CONF=expandable_segments:True
set -o pipefail
CFG=config/base.yaml
C=/aifs/user/data/lishanglin/chenhao/transformer/cache_full10
O=runs/abl
OV="model.dual_energy_head=false model.bottleneck_residual=true"
mkdir -p $O
echo "##### START $(hostname) $(date '+%F %T') #####"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
if python train.py --config $CFG --set paths.cache_dir=$C paths.out_dir=$O $OV train.epochs=50 train.compile=false 2>&1 | tee $O/train.log | tail -8; then
  python evaluate.py --config $CFG --set paths.cache_dir=$C paths.out_dir=$O $OV 2>&1 | tee $O/eval.log | tail -6
  python probe.py    --config $CFG --set paths.cache_dir=$C paths.out_dir=$O $OV 2>&1 | tee $O/probe.log | tail -10
  echo "##### ABL_DONE $(date '+%F %T') #####"
else
  echo "##### !! ABL TRAIN FAILED #####"
fi
