#!/bin/bash
#SBATCH --job-name=tf_v3_d256
#SBATCH --partition=gpu
#SBATCH --qos=gpunormal
#SBATCH --account=ihepai
#SBATCH --gres=gpu:rtx5090:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=1-00:00:00
#SBATCH --output=runs/slurm-%x-%j.out
# CAPACITY RE-CHECK d256. The old "capacity saturates at d192" conclusion came from
# single-seed runs at the d192 learning rate (3e-4), scored with the tail-sensitive
# raw-std binavg. Here: same champion objective + Gaussian-core selection, lr scaled
# DOWN for the wider model (3e-4 -> 2e-4), 50 ep. Compare gauss/robust core vs v3_d192.
cd "$SLURM_SUBMIT_DIR" || exit 1
source /aifs/user/home/lishanglin/HREDML/loadCondaEnvCuda13.sh >/dev/null 2>&1
export PYTORCH_ALLOC_CONF=expandable_segments:True
set -o pipefail
CFG=config/base.yaml
C=/aifs/user/data/lishanglin/chenhao/transformer/cache_full10
O=runs/v3_d256
mkdir -p $O
echo "##### START $(hostname) $(date '+%F %T') #####"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
if python train.py --config $CFG --set paths.cache_dir=$C paths.out_dir=$O \
     model.d_model=256 train.lr=2.0e-4 2>&1 | tee $O/train.log | tail -8; then
  for CK in best best_gauss best_robust best_raw; do
    if [ -f "$O/$CK.pt" ]; then
      echo "----- evaluate $CK -----"
      python evaluate.py --config $CFG --ckpt $O/$CK.pt --set paths.cache_dir=$C paths.out_dir=$O train.amp_dtype=fp32 \
        model.d_model=256 2>&1 | tee $O/eval_$CK.log | tail -4
      mv -f $O/metrics.json $O/metrics_$CK.json
    fi
  done
  echo "##### V3_D256_DONE $(date '+%F %T') #####"
else
  echo "##### !! V3_D256 TRAIN FAILED #####"
fi
